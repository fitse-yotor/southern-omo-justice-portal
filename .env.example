# ---- AI summaries ----
# Recommended: set only AI_ADMIN_PASSWORD, then choose the provider and paste API keys
# in the portal: Super Admin -> Settings -> AI summaries. Keys are stored encrypted.
AI_ADMIN_PASSWORD=
# Optional separate encryption secret for stored keys (defaults to AI_ADMIN_PASSWORD).
AI_SETTINGS_SECRET=
# Optional permanent settings storage on Vercel (free tier at upstash.com).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternatively configure by environment variables only (used until settings are saved in the UI):
AI_PROVIDER=ollama-cloud        # ollama-cloud | ollama-self | gemini | openai-compatible
AI_MODEL=
AI_BASE_URL=
OLLAMA_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPAT_API_KEY=
